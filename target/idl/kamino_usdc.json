    {
      "name": "AdapterState",
      "docs": [
        "Per-position adapter state PDA.",
        "",
        "`seeds = [ADAPTER_STATE_SEED, kamino_usdc_program_id, position]`",
        "",
        "Begins with the standard `AdapterStateHeader` (so any reader can decode",
        "position/ownership/shares without knowing this adapter), followed by the",
        "Kamino-specific tail."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "header",
            "docs": [
              "Standard header — MUST stay first (spec §Adapter State Account)."
            ],
            "type": {
              "defined": {
                "name": "AdapterStateHeader"
              }
            }
          },
          {
            "name": "kamino_reserve",
            "docs": [
              "The klend reserve this position deposits into (e.g. main-market USDC)."
            ],
            "type": "pubkey"
          },
          {
            "name": "collateral_vault",
            "docs": [
              "Position-owned token account holding the reserve collateral mint (cUSDC)."
            ],
            "type": "pubkey"
          },
          {
            "name": "bump",
            "docs": [
              "PDA bump."
            ],
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "AdapterStateHeader",
      "docs": [
        "The fixed prefix every adapter's state account MUST begin with, so any",
        "off-chain reader can decode position, ownership, and share count without",
        "knowing the adapter-specific tail. Embed as the FIRST field of the adapter's",
        "`#[account]` state struct: `pub struct AdapterState { pub header: AdapterStateHeader, .. }`."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "position",
            "docs": [
              "The dispatcher `Position` PDA this state backs (the CPI signer)."
            ],
            "type": "pubkey"
          },
          {
            "name": "adapter_program",
            "docs": [
              "This adapter's own program ID."
            ],
            "type": "pubkey"
          },
          {
            "name": "created_at",
            "docs": [
              "Unix timestamp of initialization."
            ],
            "type": "i64"
          },
          {
            "name": "total_shares",
            "docs": [
              "Adapter-internal shares attributable to this position (NOT the source's",
              "global supply). Units are adapter-defined (cTokens, LP, stake shares…)."
